---
import '../styles/global.css';

const business = {
  name: '訪問美容 SAMPLE',
  shortName: '訪問美容 SAMPLE',
  tagline: '美容院へ行くことが難しくなっても、髪を諦めない。',
  description: '世田谷区を中心に、美容院への来店が難しい方のご自宅へ美容師が訪問する完全予約制の訪問美容サービスです。',
  area: '世田谷区を中心に対応',
  phone: '000-0000-0000',
  email: 'example@example.com',
  priceRange: '¥¥',
  openingHours: '完全予約制',
};

const priorityAreas = ['成城','砧','祖師谷','上用賀','用賀','瀬田','玉川','二子玉川','等々力','尾山台','奥沢'];

const menus = [
  { name: '訪問カット', price: '¥8,800〜', note: 'カウンセリング・ブロー込み' },
  { name: 'カット＋カラー', price: '¥18,700〜', note: '薬剤・髪の長さにより変動' },
  { name: 'シャンプー対応', price: '+ ¥3,300〜', note: 'ご自宅の設備状況を事前確認します' },
];

const faqs = [
  { q: '世田谷区のどの地域に訪問できますか？', a: '成城、砧、祖師谷、上用賀、用賀、瀬田、玉川、二子玉川、等々力、尾山台、奥沢などを中心に対応します。世田谷区内のその他地域もご相談ください。' },
  { q: '訪問美容は誰でも自宅で利用できますか？', a: 'いいえ。訪問美容は、美容所への来店が困難な方など、法令上の対象となる場合に利用できます。疾病、障害、要介護状態などがある方を中心に、ご予約前に状況を確認します。' },
  { q: '家族から予約や相談はできますか？', a: 'はい。ご本人だけでなく、ご家族、介護関係者からのご相談やご予約にも対応します。' },
  { q: 'カラーも自宅でできますか？', a: '体調、ご自宅の環境、施術内容を事前に確認し、安全に施術できる場合に対応します。' },
  { q: '駐車場がない場合でも利用できますか？', a: 'はい。近隣の時間貸し駐車場を利用します。駐車料金が発生する場合は事前にご案内します。' }
];

const baseUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://example.github.io';
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['HealthAndBeautyBusiness','LocalBusiness'],
      '@id': `${canonicalUrl}#business`,
      name: business.name,
      description: business.description,
      url: canonicalUrl,
      telephone: business.phone,
      email: business.email,
      priceRange: business.priceRange,
      areaServed: { '@type': 'AdministrativeArea', name: '東京都世田谷区' },
      knowsAbout: ['訪問美容','高齢者向け美容','世田谷区 訪問美容','自宅訪問カット','訪問カラー']
    },
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: '世田谷区の訪問美容サービス',
      serviceType: '訪問美容',
      provider: { '@id': `${canonicalUrl}#business` },
      areaServed: { '@type': 'AdministrativeArea', name: '東京都世田谷区' }
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    }
  ]
};
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={business.description} />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:title" content={`${business.name} | 世田谷区の訪問美容`} />
  <meta property="og:description" content={business.description} />
  <meta property="og:url" content={canonicalUrl} />
  <title>{business.name} | 世田谷区の訪問美容・自宅訪問カット</title>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#top"><span class="brand-mark">H</span><span>{business.name}</span></a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="global-nav"><span></span><span></span><span></span><span class="sr-only">メニュー</span></button>
    <nav id="global-nav" class="global-nav">
      <a href="#service">サービス</a><a href="#area">対応地域</a><a href="#price">料金</a><a href="#flow">流れ</a><a href="#faq">FAQ</a><a class="nav-contact" href="#contact">お問い合わせ</a>
    </nav>
  </div>
</header>

<main id="top">
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <p class="eyebrow">SETAGAYA PRIVATE HOME BEAUTY</p>
      <h1>{business.tagline}</h1>
      <p class="hero-lead">世田谷区を中心に、美容所への移動が難しい方のご自宅へ美容師が訪問します。ご家族からのご相談も承ります。</p>
      <div class="hero-actions"><a class="button primary" href="#contact">訪問を相談する</a><a class="button secondary" href="#price">料金を見る</a></div>
      <ul class="hero-points"><li>世田谷区中心</li><li>完全予約制</li><li>ご家族からの相談可</li></ul>
    </div>
    <div class="hero-visual reveal" aria-hidden="true">
      <div class="visual-card visual-main"><div class="visual-line"></div><p>Comfort at home.</p><strong>いつもの美容を、<br />ご自宅で。</strong></div>
      <div class="visual-card visual-small"><span>01</span><p>Private<br />Home Beauty</p></div>
    </div>
  </div>
</section>

<section class="notice"><div class="container notice-inner"><strong>訪問美容とは</strong><p>美容所への来店が困難な方などを対象に、美容師がご自宅等へ訪問して施術を行うサービスです。ご予約前に対象条件と施術環境を確認します。</p></div></section>

<section id="service" class="section">
  <div class="container">
    <div class="section-heading reveal"><p class="eyebrow">SERVICE</p><h2>自宅で受けられる、上質な訪問美容。</h2><p>カットを中心に、ご自宅の環境と体調を確認したうえでカラー等にも対応します。</p></div>
    <div class="service-grid">
      <article class="service-card reveal"><span class="number">01</span><h3>ご自宅へ訪問</h3><p>美容所への移動が難しい方のご自宅へ美容師が伺います。</p></article>
      <article class="service-card reveal"><span class="number">02</span><h3>少人数・完全予約制</h3><p>一日の予約数を限定し、余裕を持ったスケジュールを組みます。</p></article>
      <article class="service-card reveal"><span class="number">03</span><h3>カット以外も相談可能</h3><p>条件が整えばカラー等にも対応します。</p></article>
    </div>
  </div>
</section>

<section id="area" class="section section-tint">
  <div class="container">
    <div class="section-heading reveal"><p class="eyebrow">AREA</p><h2>世田谷区を中心に訪問します。</h2><p>成城・砧・祖師谷・上用賀・用賀・瀬田・玉川・二子玉川・等々力・尾山台・奥沢などを中心に対応します。</p></div>
    <div class="area-focus reveal">
      <div><span class="area-label">重点対応エリア</span><h3>成城・用賀・二子玉川・等々力周辺</h3><p>重点地域は移動効率を高めることで、できるだけ出張費を抑えた運用を想定しています。</p></div>
      <a class="button secondary" href="./area/setagaya/">世田谷区の詳細を見る</a>
    </div>
    <div class="area-tags reveal">{priorityAreas.map((area) => <span>{area}</span>)}</div>
    <p class="area-note reveal">世田谷区内のその他地域もご相談ください。区外は移動時間・予約状況により個別にご案内します。</p>
  </div>
</section>

<section id="price" class="section">
  <div class="container">
    <div class="section-heading reveal"><p class="eyebrow">PRICE</p><h2>料金の目安</h2><p>下記はサンプルです。実際の原価と移動時間を確認して最終決定してください。</p></div>
    <div class="price-list reveal">{menus.map((item) => <div class="price-row"><div><h3>{item.name}</h3><p>{item.note}</p></div><strong>{item.price}</strong></div>)}</div>
    <p class="price-note reveal">※ 駐車料金、世田谷区外への移動費等が別途必要になる場合があります。すべて事前にご案内します。</p>
  </div>
</section>

<section id="flow" class="section section-tint">
  <div class="container">
    <div class="section-heading reveal"><p class="eyebrow">FLOW</p><h2>ご利用の流れ</h2></div>
    <ol class="flow-list">
      <li class="reveal"><span>1</span><div><h3>お問い合わせ</h3><p>地域、現在の状況、希望メニューをお知らせください。</p></div></li>
      <li class="reveal"><span>2</span><div><h3>事前確認</h3><p>訪問対象、体調、施術環境、駐車場所、料金を確認します。</p></div></li>
      <li class="reveal"><span>3</span><div><h3>ご訪問・施術</h3><p>必要な道具を持参し、ご自宅で施術します。</p></div></li>
      <li class="reveal"><span>4</span><div><h3>次回のご相談</h3><p>必要な場合のみ、次回時期をご案内します。</p></div></li>
    </ol>
  </div>
</section>

<section id="faq" class="section">
  <div class="container narrow">
    <div class="section-heading reveal"><p class="eyebrow">FAQ</p><h2>世田谷区の訪問美容でよくある質問</h2></div>
    <div class="faq-list reveal">{faqs.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
  </div>
</section>

<section id="contact" class="contact-section">
  <div class="container contact-grid">
    <div class="reveal"><p class="eyebrow">CONTACT</p><h2>まずは訪問できるか確認します。</h2><p>「対象になるかわからない」という段階でも構いません。地域とご本人の状況をお知らせください。</p></div>
    <div class="contact-card reveal">
      <a class="contact-method" href={`tel:${business.phone.replaceAll('-', '')}`}><span>電話</span><strong>{business.phone}</strong></a>
      <a class="contact-method" href={`mailto:${business.email}`}><span>メール</span><strong>{business.email}</strong></a>
      <p class="contact-small">{business.openingHours}。受付時間や休業日はここに記載してください。</p>
    </div>
  </div>
</section>
</main>

<footer><div class="container footer-inner"><div><strong>{business.name}</strong><p>{business.area}</p></div><p>© {new Date().getFullYear()} {business.name}</p></div></footer>

<script is:inline>
const button=document.querySelector('.menu-button');const nav=document.querySelector('.global-nav');
button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('is-open',!open);});
nav?.querySelectorAll('a').forEach((link)=>link.addEventListener('click',()=>{button?.setAttribute('aria-expanded','false');nav?.classList.remove('is-open');}));
const observer=new IntersectionObserver((entries)=>{entries.forEach((entry)=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target);}})},{threshold:.12});
document.querySelectorAll('.reveal').forEach((el)=>observer.observe(el));
</script>
</body>
</html>
